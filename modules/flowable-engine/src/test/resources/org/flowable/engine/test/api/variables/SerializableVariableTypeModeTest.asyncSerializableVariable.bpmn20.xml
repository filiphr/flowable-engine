<?xml version="1.0" encoding="UTF-8"?>
<definitions id="definitions"
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:flowable="http://flowable.org/bpmn"
  targetNamespace="Examples">
  <process id="asyncSerializableVariable">
    <startEvent id="start"/>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="serviceTask" />
    <serviceTask id="serviceTask" flowable:async="true"
      flowable:class="org.flowable.engine.test.api.variables.SerializableVariableTypeModeTest$SetSerializableVariableDelegate" />
    <sequenceFlow id="flow2" sourceRef="serviceTask" targetRef="userTask" />
    <userTask id="userTask" />
    <sequenceFlow id="flow3" sourceRef="userTask" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
